FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS openwork-builder

WORKDIR /src

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && npm install -g bun \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN pnpm install --frozen-lockfile --trust-lockfile --filter openwork-orchestrator... --filter openwork-server...

ARG TARGETARCH

RUN set -eux; \
  case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
    amd64) target="bun-linux-x64" ;; \
    arm64) target="bun-linux-arm64" ;; \
    *) echo "unsupported architecture: ${TARGETARCH:-unknown}" >&2; exit 1 ;; \
  esac; \
  pnpm --filter openwork-orchestrator exec bun ./script/build.ts --outdir dist/bin --filename openwork --target "$target"; \
  pnpm --filter openwork-server exec bun ./script/build.ts --outdir dist/bin --filename openwork-server --target "$target"

FROM node:22-bookworm-slim

ARG OPENWORK_ORCHESTRATOR_VERSION=
ARG OPENWORK_SERVER_VERSION=
ARG OPENCODE_VERSION=
ARG OPENCODE_DOWNLOAD_URL=
ARG RUNTIME_ASSERTS=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl tar unzip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=openwork-builder /src/apps/orchestrator/dist/bin /tmp/openwork-orchestrator-bin
COPY --from=openwork-builder /src/apps/server/dist/bin /tmp/openwork-server-bin
COPY --from=openwork-builder /src/constants.json /usr/local/constants.json
COPY packaging/docker/microsandbox-entrypoint.sh /usr/local/bin/microsandbox-entrypoint.sh

RUN set -eux; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) target="bun-linux-x64"; asset="opencode-linux-x64-baseline.tar.gz" ;; \
    arm64) target="bun-linux-arm64"; asset="opencode-linux-arm64.tar.gz" ;; \
    *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
  esac; \
  install -m 0755 "/tmp/openwork-orchestrator-bin/openwork-$target" /usr/local/bin/openwork; \
  install -m 0755 "/tmp/openwork-server-bin/openwork-server-$target" /usr/local/bin/openwork-server; \
  rm -rf /tmp/openwork-orchestrator-bin /tmp/openwork-server-bin; \
  if [ -z "$OPENCODE_VERSION" ]; then \
    OPENCODE_VERSION="$(node -e 'const value = require("/usr/local/constants.json").opencodeVersion; if (!value) process.exit(1); process.stdout.write(String(value).replace(/^v/, ""));')"; \
  fi; \
  url="$OPENCODE_DOWNLOAD_URL"; \
  if [ -z "$url" ]; then \
    url="https://github.com/anomalyco/opencode/releases/download/v${OPENCODE_VERSION}/${asset}"; \
  fi; \
  tmpdir="$(mktemp -d)"; \
  curl -fsSL "$url" -o "$tmpdir/$asset"; \
  tar -xzf "$tmpdir/$asset" -C "$tmpdir"; \
  binary="$(find "$tmpdir" -type f -name opencode | head -n 1)"; \
  test -n "$binary"; \
  install -m 0755 "$binary" /usr/local/bin/opencode; \
  chmod +x /usr/local/bin/microsandbox-entrypoint.sh; \
  rm -rf "$tmpdir"; \
  test -x /usr/local/bin/openwork; \
  test -x /usr/local/bin/openwork-server; \
  test -x /usr/local/bin/opencode; \
  if [ "$RUNTIME_ASSERTS" = "1" ]; then \
    test -z "$OPENWORK_ORCHESTRATOR_VERSION" || test "$(openwork --version)" = "$OPENWORK_ORCHESTRATOR_VERSION"; \
    test -z "$OPENWORK_SERVER_VERSION" || test "$(openwork-server --version)" = "$OPENWORK_SERVER_VERSION"; \
    opencode --version; \
  fi

ENV OPENWORK_DATA_DIR=/data/openwork-orchestrator
ENV OPENWORK_SIDECAR_DIR=/data/sidecars
ENV OPENWORK_WORKSPACE=/workspace

EXPOSE 8787

VOLUME ["/workspace", "/data"]

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
  CMD /bin/sh -c 'curl -fsS "http://127.0.0.1:${OPENWORK_PORT:-8787}/health" >/dev/null || exit 1'

ENTRYPOINT ["/usr/local/bin/microsandbox-entrypoint.sh"]
